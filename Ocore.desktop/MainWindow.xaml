<Window x:Class="Ocore.desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - Pharmacy Management System"
        Height="650" Width="1050"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6F5"
        FlowDirection="RightToLeft">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Background" Value="#13866B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.4*"/>
        </Grid.ColumnDefinitions>

        <!-- Login panel -->
        <Border Grid.Column="0"
                Background="White"
                Padding="55">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="O CORE"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="#13866B"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="PHARMACY MANAGEMENT SYSTEM"
                           FontSize="11"
                           Foreground="#687A75"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,40"/>

                <TextBlock Text="تسجيل الدخول"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#183B35"
                           Margin="0,0,0,8"/>

                <TextBlock Text="مرحباً بك، يرجى إدخال بيانات حسابك"
                           Foreground="#71817C"
                           Margin="0,0,0,28"/>

                <TextBlock Text="اسم المستخدم"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="UsernameBox"
         Style="{StaticResource InputStyle}"
         FlowDirection="LeftToRight"
         Text=""
         KeyDown="UsernameBox_KeyDown"/>

                <TextBlock Text="كلمة المرور"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>

                <PasswordBox x:Name="PasswordBox"
             Height="45"
             FontSize="15"
             Padding="12,8"
             BorderBrush="#DCE5E1"
             BorderThickness="1"
             KeyDown="PasswordBox_KeyDown"/>
                
                
                <CheckBox Content="تذكر اسم المستخدم"
                          Margin="0,20,0,25"
                          Foreground="#52645E"/>

                <Button Content="تسجيل الدخول"
        Style="{StaticResource LoginButton}"
        IsDefault="True"
        Click="LoginButton_Click"/>

                <TextBlock x:Name="StatusText"
                           Foreground="#C0392B"
                           Margin="0,15,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </Border>

        <!-- Branding panel -->
        <Grid Grid.Column="1" Background="#123D35">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Border Width="125" Height="125"
                        CornerRadius="28"
                        Background="#13866B"
                        HorizontalAlignment="Center">
                    <TextBlock Text="O"
                               FontSize="85"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="O CORE"
                           FontSize="42"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,25,0,8"/>

                <TextBlock Text="إدارة صيدليتك بذكاء وسهولة"
                           FontSize="20"
                           Foreground="#C4E4D9"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="SAFETY • ACCURACY • CONTROL"
                           FontSize="11"
                           Foreground="#91BEB0"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
