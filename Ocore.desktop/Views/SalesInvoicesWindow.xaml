<Window x:Class="Ocore.desktop.Views.SalesInvoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - سجل فواتير البيع"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock Text="سجل فواتير البيع"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="عرض ومتابعة جميع فواتير البيع"
                           FontSize="13"
                           Foreground="#64736F"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- البحث والتصفية -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="بحث برقم الفاتورة أو اسم الموظف"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="35"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="من تاريخ"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <DatePicker x:Name="FromDatePicker"
                                Height="35"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="إلى تاريخ"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <DatePicker x:Name="ToDatePicker"
                                Height="35"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="بحث"
                        Width="75"
                        Height="35"
                        Margin="4,22,4,0"
                        Background="#16865D"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="4"
                        Content="إعادة ضبط"
                        Width="90"
                        Height="35"
                        Margin="4,22,4,0"
                        Background="#64736F"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ResetButton_Click"/>
            </Grid>
        </Border>

        <!-- جدول الفواتير -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="InvoicesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      FontSize="13"
                      MouseDoubleClick="InvoicesDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="رقم الفاتورة"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="اسم الموظف"
                                        Binding="{Binding EmployeeName}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}"
                                        Width="1.7*"/>

                    <DataGridTextColumn Header="الإجمالي"
                                        Binding="{Binding Total, StringFormat={}{0:N2}}"
                                        Width="1.2*"/>

                    <DataGridTemplateColumn Header="الحالة"
                                            Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E5F4EB"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        HorizontalAlignment="Center">

                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#16865D"
                                               FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الملخص والأزرار -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="InvoicesCountText"
                           Text="عدد الفواتير: 0"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="InvoicesTotalText"
                           Grid.Column="1"
                           Text="إجمالي القيمة: 0.00"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#16865D"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="Excel"
                        Width="85"
                        Padding="8"
                        Margin="3"
                        Background="#217346"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ExportExcelButton_Click"/>

                <Button Grid.Column="3"
                        Content="PDF"
                        Width="75"
                        Padding="8"
                        Margin="3"
                        Background="#B83232"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ExportPdfButton_Click"/>

                <Button Grid.Column="4"
                        Content="🔄 تحديث"
                        Width="90"
                        Padding="8"
                        Margin="3"
                        Background="#246B58"
                        Foreground="White"
                        BorderThickness="0"
                        Click="RefreshButton_Click"/>

                <Button Grid.Column="5"
                        Content="عرض التفاصيل"
                        Width="125"
                        Padding="8"
                        Margin="3"
                        Background="#183F36"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ViewInvoiceButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
