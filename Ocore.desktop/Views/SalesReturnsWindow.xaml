<Window x:Class="Ocore.desktop.Views.SalesReturnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - مرتجعات البيع"
        Height="650"
        Width="1100"
        MinHeight="500"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F5F8">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,12">

            <StackPanel>
                <TextBlock Text="مرتجعات البيع"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="ابحث عن فاتورة برقمها أو باسم الصنف أو كوده، ثم افتح الفاتورة لتنفيذ المرتجع."
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- البحث -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="رقم الفاتورة أو اسم الصنف أو كود الصنف"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="40"
                             FontSize="15"
                             Padding="10"
                             VerticalContentAlignment="Center"
                             ToolTip="اكتب رقم الفاتورة أو اسم الصنف أو كوده"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="بحث"
                        Width="100"
                        Height="40"
                        Margin="12,25,0,0"
                        Click="SearchButton_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"/>
            </Grid>
        </Border>

        <!-- نتائج البحث فقط -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="الفواتير المطابقة للبحث"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="0,0,0,12"/>

                <DataGrid x:Name="InvoicesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="42"
                          FontSize="13"
                          Background="White"
                          BorderBrush="#E2E8F0"
                          AlternatingRowBackground="#F8FAFC"
                          CanUserSortColumns="True"
                          MouseDoubleClick="InvoicesDataGrid_MouseDoubleClick">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="رقم الفاتورة"
                                            Binding="{Binding InvoiceNumber}"
                                            Width="1.2*"/>

                        <DataGridTextColumn Header="تاريخ البيع"
                                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="الموظف"
                                            Binding="{Binding EmployeeName}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="إجمالي الفاتورة"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="1.2*"/>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="ItemsStatusText"
                           Grid.Row="2"
                           Text="اكتب رقم الفاتورة أو اسم الصنف أو كوده لعرض الفواتير المطابقة."
                           Foreground="#64748B"
                           Margin="0,12,0,0"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- إغلاق -->
        <Grid Grid.Row="3">
            <Button Content="إغلاق"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Left"
                    Click="CloseButton_Click"
                    Background="#64748B"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"/>
        </Grid>
    </Grid>
</Window>
