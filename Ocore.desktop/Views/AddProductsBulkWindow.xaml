<Window x:Class="Ocore.desktop.Views.AddProductsBulkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - إضافة مجموعة أصناف"
        Width="1500" Height="760" MinWidth="1050" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="#123D35"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="إضافة مجموعة أصناف"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="أدخل الأصناف في صفوف متتالية أو انسخ جدولًا من Excel والصقه مباشرة."
                           Foreground="#D7E8E2"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- أدوات التحكم وتعليمات اللصق -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10">

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">

                    <Button x:Name="AddRowButton"
                            Content="＋ إضافة صف"
                            Width="105"
                            Height="34"
                            Margin="3"/>

                    <Button x:Name="RemoveRowButton"
                            Content="－ حذف الصف المحدد"
                            Width="145"
                            Height="34"
                            Margin="3"/>

                    <Button x:Name="PasteButton"
                            Content="📋 لصق من Excel"
                            Width="125"
                            Height="34"
                            Margin="3"/>

                    <Button x:Name="ImportExcelButton"
                            Content="📥 استيراد Excel"
                            Width="125"
                            Height="34"
                            Margin="3"/>

                    <Button x:Name="ExportExcelButton"
                            Content="📤 تصدير Excel"
                            Width="125"
                            Height="34"
                            Margin="3"/>

                </StackPanel>

                <TextBlock x:Name="HelpTextBlock"
                           Text="يمكنك لصق جدول كامل من Excel بالترتيب الموضح، أو نسخ عمود واحد واختيار أول خلية في العمود المطلوب ثم الضغط على Ctrl+V."
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="#52616B"/>

            </DockPanel>
        </Border>

        <!-- جدول الأصناف -->
        <DataGrid x:Name="ProductsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  MinRowHeight="36"
                  FontSize="11"
                  Background="White"
                  AlternatingRowBackground="#F7FAF9"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">

            <!-- تنسيق عناوين الأعمدة -->
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="3,5"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="10"/>
                    <Setter Property="Background" Value="#E8F0ED"/>
                    <Setter Property="Foreground" Value="#183F36"/>
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>

                <!-- اسم الصنف -->
                <DataGridTextColumn Header="اسم الصنف *"
                                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                    Width="2.5*">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="TextTrimming" Value="None"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="4,3"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="3"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>

                </DataGridTextColumn>

                <!-- التصنيف -->
                <DataGridTemplateColumn Header="التصنيف"
                                        Width="1.4*">

                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CategoryName}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="3,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding CategoryOptions}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding CategoryId, UpdateSourceTrigger=PropertyChanged}"
                                      IsTextSearchEnabled="True"
                                      FontSize="10"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>

                </DataGridTemplateColumn>

                <!-- العبوة -->
                <DataGridTextColumn Header="العبوة"
                                    Binding="{Binding UnitName}"
                                    IsReadOnly="True"
                                    Width="0.85*"/>

                <!-- الوحدة الصغيرة -->
                <DataGridTextColumn Header="الوحدة الصغيرة"
                                    Binding="{Binding SmallUnitName}"
                                    IsReadOnly="True"
                                    Width="1.05*"/>

                <!-- عدد الوحدات -->
                <DataGridTextColumn Header="عدد الوحدات *"
                                    Binding="{Binding UnitsPerPackage, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.85*"/>

                <!-- سعر البيع -->
                <DataGridTextColumn Header="سعر البيع"
                                    Binding="{Binding SalePrice, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.8*"/>

                <!-- سعر الشراء -->
                <DataGridTextColumn Header="سعر الشراء"
                                    Binding="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.8*"/>

                <!-- الكمية الافتتاحية -->
                <DataGridTextColumn Header="الكمية الافتتاحية"
                                    Binding="{Binding InitialQuantity, UpdateSourceTrigger=PropertyChanged}"
                                    Width="0.95*"/>

                <!-- رقم التشغيلة -->
                <DataGridTextColumn Header="رقم التشغيلة"
                                    Binding="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                    Width="1.05*"/>

                <!-- تاريخ الصلاحية -->
                <DataGridTextColumn Header="تاريخ الصلاحية"
                                    Binding="{Binding ExpiryDate, UpdateSourceTrigger=PropertyChanged}"
                                    Width="1.1*"/>

                <!-- إلزام تاريخ الصلاحية لهذا الصنف فقط -->
                <DataGridTemplateColumn Header="يتطلب تاريخ الصلاحية"
                                        Width="0.9*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding RequiresExpiryDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      ToolTip="فعّل هذا الخيار إذا كان يجب إدخال تاريخ صلاحية للصنف عند الشراء."/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- حالة الصف -->
                <DataGridTextColumn Header="حالة الصف"
                                    Binding="{Binding Status}"
                                    IsReadOnly="True"
                                    Width="1.4*">

                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="3,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>

                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- الملخص وأزرار الحفظ -->
        <DockPanel Grid.Row="3"
                   Margin="0,10,0,0">

            <TextBlock x:Name="SummaryTextBlock"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#183F36"
                       Text="جاهز لإدخال الأصناف."/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="SaveButton"
                        Content="💾 حفظ الأصناف"
                        Width="140"
                        Height="40"
                        Margin="4"
                        Background="#16865D"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Button x:Name="CloseButton"
                        Content="إغلاق"
                        Width="100"
                        Height="40"
                        Margin="4"/>

            </StackPanel>
        </DockPanel>

    </Grid>
</Window>
