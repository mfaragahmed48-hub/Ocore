<Window x:Class="Ocore.desktop.Views.PrinterSettingsHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الطابعات"
        Width="650"
        Height="430"
        MinWidth="550"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F5F8"
        ResizeMode="CanResize">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="إعدادات الطابعات"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#243247"/>

            <TextBlock Text="اختر نوع الطابعة التي تريد ضبط إعداداتها"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="1" Rows="3">

            <Button x:Name="CashierButton"
                    Click="CashierButton_Click"
                    Margin="0,5"
                    Padding="16"
                    Background="White"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE8C7;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="#2674C8"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0">
                        <TextBlock Text="طابعة الكاشير"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#243247"/>
                        <TextBlock Text="فواتير البيع ومرتجعات البيع"
                                   FontSize="12"
                                   Foreground="#718096"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#718096"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="NormalButton"
                    Click="NormalButton_Click"
                    Margin="0,5"
                    Padding="16"
                    Background="White"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE8A5;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="#16866A"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0">
                        <TextBlock Text="الطابعة العادية"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#243247"/>
                        <TextBlock Text="فواتير الشراء والتقارير والمستندات"
                                   FontSize="12"
                                   Foreground="#718096"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#718096"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <Button x:Name="BarcodeButton"
                    Click="BarcodeButton_Click"
                    Margin="0,5"
                    Padding="16"
                    Background="White"
                    BorderBrush="#DCE3EC"
                    BorderThickness="1"
                    HorizontalContentAlignment="Stretch">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE8EC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="#B7791F"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Margin="12,0">
                        <TextBlock Text="طابعة الباركود"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#243247"/>
                        <TextBlock Text="طباعة ملصقات Roll فقط"
                                   FontSize="12"
                                   Foreground="#718096"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               Text="&#xE76C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#718096"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>

        </UniformGrid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE3EC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,18,0,0">

            <TextBlock Text="إعدادات كل نوع طابعة مستقلة ومحفوظة على هذا الجهاز."
                       FontSize="12"
                       Foreground="#718096"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
