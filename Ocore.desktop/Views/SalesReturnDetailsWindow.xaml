<Window x:Class="Ocore.desktop.Views.SalesReturnDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفاصيل مرتجع البيع"
        Height="650"
        Width="950"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F6F8"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#123D35"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="تفاصيل مرتجع البيع"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="مراجعة بيانات المرتجع والأصناف المرتجعة"
                           FontSize="13"
                           Foreground="#C5DED5"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="رقم المرتجع" Foreground="#64736F"/>
                    <TextBlock x:Name="ReturnNumberText"
                               Text="-"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#183F36"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="رقم فاتورة البيع الأصلية"
                               Foreground="#64736F"/>
                    <TextBlock x:Name="InvoiceNumberText"
                               Text="-"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#183F36"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0"
                            Margin="5,12,5,5">
                    <TextBlock Text="الموظف" Foreground="#64736F"/>
                    <TextBlock x:Name="EmployeeNameText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Margin="5,12,5,5">
                    <TextBlock Text="تاريخ المرتجع" Foreground="#64736F"/>
                    <TextBlock x:Name="ReturnDateText"
                               Text="-"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0"
                            Margin="5,12,5,5">
                    <TextBlock Text="حالة المرتجع" Foreground="#64736F"/>
                    <TextBlock x:Name="ReturnStatusText"
                               Text="-"
                               FontWeight="Bold"
                               Foreground="#16865D"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1"
                            Margin="5,12,5,5">
                    <TextBlock Text="سبب المرتجع" Foreground="#64736F"/>
                    <TextBlock x:Name="ReturnReasonText"
                               Text="-"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="الأصناف المرتجعة"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           Margin="5,0,5,12"/>

                <DataGrid x:Name="ItemsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38"
                          FontSize="13"
                          Background="White"
                          BorderThickness="0"
                          FlowDirection="RightToLeft"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الصنف"
                                            Binding="{Binding ItemName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="الوحدة المرتجعة"
                                            Binding="{Binding ReturnUnitName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الكمية"
                                            Binding="{Binding ReturnUnitQuantity, StringFormat=N2}"
                                            Width="*"/>

                        <DataGridTextColumn Header="سعر الوحدة"
                                            Binding="{Binding ReturnUnitPrice, StringFormat=N2}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="إجمالي قيمة المرتجع"
                               Foreground="#64736F"
                               FontSize="13"/>

                    <TextBlock x:Name="ReturnTotalText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#16865D"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="معاينة وطباعة الإيصال"
                        Width="180"
                        Height="42"
                        Margin="0,0,10,0"
                        Padding="10"
                        Background="#16865D"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="PrintButton_Click"/>

                <Button Grid.Column="2"
                        Content="إغلاق"
                        Width="110"
                        Height="42"
                        Padding="10"
                        Background="#123D35"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
