<Window x:Class="Ocore.desktop.Views.UsersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - إدارة المستخدمين"
        Height="650"
        Width="1050"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="إدارة المستخدمين"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="إضافة ومتابعة حسابات العاملين بالصيدلية"
                           FontSize="14"
                           Foreground="#64736F"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- نموذج الإضافة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20"
                Margin="0,0,0,15">

            <StackPanel>

                <TextBlock Text="إضافة مستخدم جديد"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="5">
                        <TextBlock Text="الاسم الكامل"/>
                        <TextBox x:Name="FullNameBox"
                                 Height="35"
                                 Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="5">
                        <TextBlock Text="اسم المستخدم"/>
                        <TextBox x:Name="UsernameBox"
                                 Height="35"
                                 Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="5">
                        <TextBlock Text="كلمة المرور"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="35"
                                     Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="5">
                        <TextBlock Text="نوع المستخدم"/>
                        <ComboBox x:Name="RoleComboBox"
                                  Height="35"
                                  Margin="0,5"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="صيدلي"
                                          Tag="Pharmacist"/>
                            <ComboBoxItem Content="كاشير"
                                          Tag="Cashier"/>
                        </ComboBox>
                    </StackPanel>

                    <Button Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Content="➕ إضافة المستخدم"
                            Height="42"
                            Margin="5,15,5,0"
                            Background="#16865D"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="AddUser_Click"/>
                </Grid>

            </StackPanel>
        </Border>

        <!-- جدول المستخدمين -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <DockPanel>

                <TextBlock DockPanel.Dock="Top"
                           Text="المستخدمون المسجلون"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           Margin="0,0,0,15"/>

                <DataGrid x:Name="UsersDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          FlowDirection="RightToLeft"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الرقم"
                                            Binding="{Binding Id}"
                                            Width="70"/>

                        <DataGridTextColumn Header="اسم المستخدم"
                                            Binding="{Binding Username}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الاسم الكامل"
                                            Binding="{Binding FullName}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الدور"
                                            Binding="{Binding Role}"
                                            Width="110"/>

                        <DataGridTextColumn Header="الحالة"
                                            Binding="{Binding StatusText}"
                                            Width="90"/>

                        <DataGridTemplateColumn Header="التحكم"
                                                Width="340">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <Button Content="تعديل"
                                                Padding="8,5"
                                                Margin="3"
                                                Background="#1976D2"
                                                Foreground="White"
                                                Click="EditUser_Click"/>

                                        <Button Content="تغيير الحالة"
                                                Padding="8,5"
                                                Margin="3"
                                                Click="ChangeUserStatus_Click"/>

                                        <Button Content="تغيير كلمة المرور"
                                                Padding="8,5"
                                                Margin="3"
                                                Background="#E67E22"
                                                Foreground="White"
                                                Click="ResetPassword_Click"/>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>
        </Border>

    </Grid>
</Window>
