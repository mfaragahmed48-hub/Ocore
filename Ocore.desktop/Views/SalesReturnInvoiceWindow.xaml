<Window x:Class="Ocore.desktop.Views.SalesReturnInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - تفاصيل فاتورة المرتجع"
        Height="780"
        Width="1450"
        MinHeight="650"
        MinWidth="1150"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F5F8"
        ResizeMode="CanResize">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- بيانات الفاتورة -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="رقم الفاتورة"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="InvoiceNumberText"
                               Text="-"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#1E293B"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="تاريخ البيع"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="InvoiceDateText"
                               Text="-"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="الموظف"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="EmployeeNameText"
                               Text="-"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="3" Margin="5">
                    <TextBlock Text="إجمالي الفاتورة الأصلي"
                               Foreground="#64748B"/>
                    <TextBlock x:Name="InvoiceTotalText"
                               Text="0.00"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="4"
                        x:Name="ReturnFullInvoiceButton"
                        Content="إرجاع الفاتورة كاملة"
                        Width="175"
                        Height="40"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsEnabled="False"
                        Click="ReturnFullInvoiceButton_Click"
                        Background="#D97706"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"/>

                <!-- المرتجعات السابقة وصافي الفاتورة -->
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="4"
                      Margin="5,12,5,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,10,0">

                        <TextBlock Text="إجمالي المرتجعات السابقة"
                                   Foreground="#64748B"
                                   FontSize="12"/>

                        <TextBlock x:Name="PreviousReturnsTotalText"
                                   Text="0.00"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="10,0,0,0">

                        <TextBlock Text="صافي الفاتورة بعد المرتجعات"
                                   Foreground="#64748B"
                                   FontSize="12"/>

                        <TextBlock x:Name="NetInvoiceTotalText"
                                   Text="0.00"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- جميع أصناف الفاتورة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="أصناف الفاتورة - حدد الكميات المراد إرجاعها"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#1E293B"
                           Margin="5,0,5,12"/>

                <DataGrid x:Name="ItemsDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="42"
                          FontSize="12"
                          Background="White"
                          BorderBrush="#E2E8F0"
                          AlternatingRowBackground="#F8FAFC"
                          CanUserSortColumns="True"
                          CellEditEnding="ItemsDataGrid_CellEditEnding">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="كود الصنف"
                                            Binding="{Binding ProductCode}"
                                            Width="*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="اسم الصنف"
                                            Binding="{Binding ItemName}"
                                            Width="2*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="وحدة البيع"
                                            Binding="{Binding UnitName}"
                                            Width="0.9*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="المباع"
                                            Binding="{Binding SoldQuantity, StringFormat=N2}"
                                            Width="0.8*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="مرتجع سابقًا"
                                            Binding="{Binding ReturnedQuantity, StringFormat=N2}"
                                            Width="0.9*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="المتاح للمرتجع"
                                            Binding="{Binding RemainingQuantity, StringFormat=N2}"
                                            Width="1*"
                                            IsReadOnly="True"/>

                        <DataGridTemplateColumn Header="وحدة المرتجع"
                                                Width="1.1*"
                                                IsReadOnly="False">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnUnitName}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding ReturnUnits}"
                                              SelectedItem="{Binding ReturnUnitName,
                                                  Mode=TwoWay,
                                                  UpdateSourceTrigger=PropertyChanged}"
                                              SelectionChanged="ReturnUnitComboBox_SelectionChanged"
                                              VerticalContentAlignment="Center"
                                              Padding="4"
                                              MinWidth="85"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="كمية المرتجع"
                                                Width="1.1*"
                                                IsReadOnly="False">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ReturnUnitQuantity, StringFormat=N2}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>

                                    <TextBox Text="{Binding ReturnUnitQuantity,
        Mode=TwoWay,
        UpdateSourceTrigger=LostFocus,
        ValidatesOnExceptions=True}"
         TextChanged="ReturnQuantityTextBox_TextChanged"
         FlowDirection="LeftToRight"
         Language="en-US"
         VerticalContentAlignment="Center"
         HorizontalContentAlignment="Center"
         Padding="4"/>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>

                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="سعر الوحدة"
                                            Binding="{Binding ReturnUnitPrice, StringFormat=N2}"
                                            Width="0.9*"
                                            IsReadOnly="True"/>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding Total, StringFormat=N2}"
                                            Width="0.9*"
                                            IsReadOnly="True"/>

                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="ItemsStatusText"
                           Grid.Row="2"
                           Text="جميع أصناف الفاتورة تظهر هنا، بما فيها الأصناف المرتجعة بالكامل."
                           Foreground="#64748B"
                           Margin="5,10,5,0"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- بيانات المرتجع والحفظ -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="سبب المرتجع"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBox x:Name="ReasonTextBox"
                             Height="38"
                             FontSize="13"
                             Padding="8"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="12,0">

                    <TextBlock Text="إجمالي المرتجع"
                               FontWeight="SemiBold"
                               Margin="0,0,0,7"/>

                    <TextBlock x:Name="ReturnTotalText"
                               Text="0.00"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#DC2626"/>
                </StackPanel>

                <Grid Grid.Column="2"
                      Margin="8,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Margin="0,0,6,0">

                        <TextBlock Text="المبلغ المصروف فعليًا"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="RefundAmountTextBox"
                                 Text="0"
                                 Height="38"
                                 FontSize="14"
                                 Padding="8"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Margin="6,0,0,0">

                        <TextBlock Text="وسيلة الرد"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>

                        <ComboBox x:Name="RefundPaymentMethodComboBox"
                                  Height="38"
                                  FontSize="13"
                                  Padding="6"
                                  VerticalContentAlignment="Center"
                                  SelectedIndex="-1">

                            <ComboBoxItem Content="نقدي"
                                          Tag="Cash"/>

                            <ComboBoxItem Content="فيزا"
                                          Tag="Card"/>

                            <ComboBoxItem Content="إنستا باي"
                                          Tag="InstaPay"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">

                    <Button x:Name="SaveReturnButton"
                            Content="حفظ المرتجع"
                            Width="125"
                            Height="40"
                            Margin="5,0"
                            Background="#16A34A"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="SaveReturnButton_Click"/>

                    <Button Content="إغلاق"
                            Width="85"
                            Height="40"
                            Margin="5,0"
                            Background="#64748B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
