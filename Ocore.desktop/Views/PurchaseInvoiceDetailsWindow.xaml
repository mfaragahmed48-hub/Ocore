 <Window x:Class="Ocore.desktop.Views.PurchaseInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - تفاصيل فاتورة الشراء"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <DockPanel>
                <TextBlock Text="📄   تفاصيل فاتورة الشراء"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="O CORE"
                           DockPanel.Dock="Left"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#16865D"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- بيانات الفاتورة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="8">
                    <TextBlock Text="رقم الفاتورة"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="InvoiceNumberText"
                               Text="-"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#183F36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8">
                    <TextBlock Text="اسم المورد"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="SupplierNameText"
                               Text="-"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#183F36"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8">
                    <TextBlock Text="تاريخ الفاتورة"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="InvoiceDateText"
                               Text="-"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#183F36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- تفاصيل الأصناف -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="InvoiceItemsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F3F7F5">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="الصنف"
                                        Binding="{Binding ItemName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="الوحدة"
                                        Binding="{Binding UnitName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="رقم التشغيلة"
                                        Binding="{Binding BatchNumber}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="تاريخ الصلاحية"
                                        Binding="{Binding ExpiryDateText}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity}"
                                        Width="*"/>

                    <DataGridTextColumn Header="سعر الوحدة"
                                        Binding="{Binding UnitPrice, StringFormat=N2}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="الإجمالي"
                                        Binding="{Binding Total, StringFormat=N2}"
                                        Width="1.2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- إجمالي الفاتورة وأزرار التحكم -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,12,0,0">

            <DockPanel LastChildFill="True">

                <StackPanel>
                    <TextBlock Text="إجمالي الفاتورة"
                               Foreground="#64736F"
                               FontSize="13"/>

                    <TextBlock x:Name="InvoiceTotalText"
                               Text="0.00"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#16865D"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="🖨 طباعة الفاتورة"
                            Width="160"
                            Height="38"
                            Margin="5"
                            Background="#16865D"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="PrintInvoiceButton_Click"/>

                    <Button Content="إغلاق"
                            Width="110"
                            Height="38"
                            Margin="5"
                            Background="#246B58"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>

    </Grid>
</Window>