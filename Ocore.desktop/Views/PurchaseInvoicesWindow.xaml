<Window x:Class="Ocore.desktop.Views.PurchaseInvoicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - سجل فواتير الشراء"
        Height="650"
        Width="1050"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <DockPanel>
                <TextBlock Text="📋   سجل فواتير الشراء"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock DockPanel.Dock="Left"
                           Text="O CORE"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#16865D"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- البحث والتصفية -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5">
                    <TextBlock Text="بحث برقم الفاتورة أو المورد"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="34"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5">
                    <TextBlock Text="من تاريخ"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <DatePicker x:Name="FromDatePicker"
                                Height="34"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="5">
                    <TextBlock Text="إلى تاريخ"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>

                    <DatePicker x:Name="ToDatePicker"
                                Height="34"
                                SelectedDateChanged="DatePicker_SelectedDateChanged"/>
                </StackPanel>

                <Button Grid.Column="3"
                        Content="🔍 بحث"
                        Width="85"
                        Height="34"
                        Margin="5,20,5,0"
                        Background="#246B58"
                        Foreground="White"
                        BorderThickness="0"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="4"
                        Content="إعادة ضبط"
                        Width="90"
                        Height="34"
                        Margin="5,20,5,0"
                        Background="#64736F"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ResetButton_Click"/>
            </Grid>
        </Border>

        <!-- جدول الفواتير -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="InvoicesDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="40"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F3F7F5"
                      MouseDoubleClick="InvoicesDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="رقم الفاتورة"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="المورد"
                                        Binding="{Binding SupplierName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="تاريخ الفاتورة"
                                        Binding="{Binding InvoiceDate, StringFormat=dd/MM/yyyy}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="الإجمالي"
                                        Binding="{Binding Total, StringFormat=N2}"
                                        Width="1.2*"/>

                    <DataGridTemplateColumn Header="الحالة"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E5F4EB"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}"
                                               Foreground="#16865D"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- أسفل الشاشة -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="InvoicesCountText"
                           Grid.Column="0"
                           Text="عدد الفواتير: 0"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="InvoicesTotalText"
                           Grid.Column="1"
                           Text="إجمالي القيمة: 0.00"
                           FontWeight="Bold"
                           Foreground="#16865D"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="2"
                        Content="🔄 تحديث"
                        Width="105"
                        Height="38"
                        Margin="5,0"
                        Background="#64736F"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="RefreshButton_Click"/>

                <Button Grid.Column="3"
                        Content="📄 عرض تفاصيل الفاتورة"
                        Width="190"
                        Height="38"
                        Margin="5,0,0,0"
                        Background="#16865D"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Click="ViewInvoiceButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>