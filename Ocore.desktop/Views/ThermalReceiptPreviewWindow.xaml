<Window x:Class="Ocore.desktop.Views.ThermalReceiptPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - معاينة الإيصال الحراري"
        Height="800"
        Width="1000"
        MinHeight="650"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F1F4F7">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <!-- عنوان المعاينة -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,12"
                BorderBrush="#DCE3EA"
                BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <TextBlock Text="معاينة الإيصال الحراري"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#263445"/>

                    <TextBlock Text="راجع شكل الفاتورة قبل الطباعة"
                               FontSize="12"
                               Foreground="#788797"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Button x:Name="RefreshPreviewButton"
                        Grid.Column="1"
                        Content="تحديث المعاينة"
                        Width="125"
                        Height="36"
                        VerticalAlignment="Center"
                        Background="#1769AA"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- مساحة عرض الإيصال -->
        <Border Grid.Row="1"
                Background="#E4EAF0"
                CornerRadius="8"
                Padding="16"
                BorderBrush="#D4DDE6"
                BorderThickness="1">

            <ScrollViewer x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="Transparent">

                <Border x:Name="ReceiptPaperBorder"
                        Background="White"
                        Padding="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        BorderBrush="#D5D5D5"
                        BorderThickness="1">

                    <Image x:Name="ReceiptPreviewImage"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
            </ScrollViewer>
        </Border>

        <!-- شريط الأزرار السفلي -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                BorderBrush="#DCE3EA"
                BorderThickness="1"
                Padding="10,6"
                Margin="0,12,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PreviewStatusText"
                           Grid.Column="0"
                           Text="جاهز للمعاينة"
                           VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="12"/>

                <Button x:Name="PrintButton"
                        Grid.Column="1"
                        Content="طباعة الإيصال"
                        Width="145"
                        Height="42"
                        Margin="8,0"
                        IsEnabled="False"
                        Visibility="Visible"
                        Background="#16834A"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        FontSize="14"
                        Cursor="Hand"
                        ToolTip="طباعة الإيصال الحراري"/>

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Content="إغلاق"
                        Width="90"
                        Height="42"
                        Background="#E5EAF0"
                        Foreground="#334155"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
