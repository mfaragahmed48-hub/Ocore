<Window x:Class="Ocore.desktop.Views.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - الإعداد الأول"
        Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F3F7F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#087F5B">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="O CORE"
                           FontSize="38"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="PHARMACY MANAGEMENT"
                           FontSize="13"
                           Foreground="White"
                           Margin="0,8,0,0"/>
                <TextBlock Text="نظام إدارة الصيدلية"
                           FontSize="20"
                           Foreground="White"
                           Margin="0,25,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="55,35">

                <TextBlock Text="إعداد المدير الأول"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#173B32"/>

                <TextBlock Text="أنشئ حساب المسؤول الرئيسي للنظام"
                           FontSize="14"
                           Foreground="#687B74"
                           Margin="0,8,0,30"/>

                <TextBlock Text="الاسم الكامل"/>
                <TextBox x:Name="FullNameBox"
                         Height="40"
                         Margin="0,6,0,18"
                         FontSize="15"/>

                <TextBlock Text="اسم المستخدم"/>
                <TextBox x:Name="UsernameBox"
                         Height="40"
                         Margin="0,6,0,18"
                         FontSize="15"/>

                <TextBlock Text="كلمة المرور"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="40"
                             Margin="0,6,0,18"
                             FontSize="15"/>

                <TextBlock Text="تأكيد كلمة المرور"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="40"
                             Margin="0,6,0,25"
                             FontSize="15"/>

                <Button Content="إنشاء حساب المدير"
                        Height="48"
                        Background="#087F5B"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CreateAdmin_Click"/>

                <TextBlock Text="يتم إنشاء هذا الحساب مرة واحدة عند الإعداد الأول."
                           Foreground="#687B74"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,20,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
