<Window x:Class="Ocore.desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - إعدادات الصيدلية"
        Height="720"
        Width="850"
        MinHeight="600"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6FA">

    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

    </Window.Resources>

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس الشاشة -->
        <Border Grid.Row="0"
                Background="#17365D"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,20">

            <StackPanel>
                <TextBlock Text="⚙ إعدادات الصيدلية"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="إدارة بيانات الصيدلية والشعار المستخدم في الفواتير"
                           FontSize="13"
                           Foreground="#DCE6F1"
                           Margin="0,8,0,0"/>
            </StackPanel>

        </Border>

        <!-- محتوى الإعدادات -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <Border Background="White"
                    CornerRadius="12"
                    Padding="25"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="البيانات الأساسية"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#17365D"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="اسم الصيدلية"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="PharmacyNameTextBox"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,0,18"
                             ToolTip="أدخل اسم الصيدلية"/>

                    <TextBlock Text="العنوان"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="AddressTextBox"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,0,18"
                             ToolTip="أدخل عنوان الصيدلية"/>

                    <TextBlock Text="رقم الهاتف"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="PhoneTextBox"
                             Style="{StaticResource InputBox}"
                             FlowDirection="LeftToRight"
                             Margin="0,0,0,18"
                             ToolTip="أدخل رقم الهاتف"/>

                    <TextBlock Text="الرقم الضريبي (اختياري)"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="TaxNumberTextBox"
                             Style="{StaticResource InputBox}"
                             FlowDirection="LeftToRight"
                             Margin="0,0,0,18"
                             ToolTip="أدخل الرقم الضريبي إن وجد"/>

                    <TextBlock Text="اسم المسؤول"
                               Style="{StaticResource FieldLabel}"/>

                    <TextBox x:Name="ManagerNameTextBox"
                             Style="{StaticResource InputBox}"
                             Margin="0,0,0,20"
                             ToolTip="أدخل اسم المسؤول عن الصيدلية"/>

                    <Separator Margin="0,5,0,20"/>

                    <!-- شعار الصيدلية -->
                    <TextBlock Text="شعار الصيدلية"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="#17365D"
                               Margin="0,0,0,15"/>

                    <Border Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15">

                        <StackPanel>

                            <Border Width="140"
                                    Height="140"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    Padding="5">

                                <Image x:Name="LogoPreviewImage"
                                       Stretch="Uniform"/>
                            </Border>

                            <TextBlock x:Name="LogoPathText"
                                       Text="لم يتم اختيار شعار بعد"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,12"/>

                            <Button Content="اختيار صورة الشعار"
                                    Width="180"
                                    Height="40"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    Click="ChooseLogoButton_Click"/>

                        </StackPanel>

                    </Border>

                    <Border Background="#F1F5F9"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,20,0,0">

                        <TextBlock Text="ملاحظة: سيتم استخدام بيانات الصيدلية والشعار في ترويسة فواتير البيع والشراء عند الطباعة."
                                   Foreground="#475569"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>

                    </Border>

                    <!-- دليل الأدوية -->
                    <Separator Margin="0,25,0,20"/>

                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="📚 دليل الأدوية"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="استيراد قاعدة بيانات الأدوية من ملف CSV لإتاحة البحث عن الأدوية بالاسم التجاري والمادة الفعالة والشركة المصنعة."
                                       Foreground="#334155"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="ملاحظة: استيراد الدليل لا يضيف الأدوية إلى المخزون ولا ينشئ أصنافًا قابلة للبيع تلقائيًا."
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <Button x:Name="ImportDrugCatalogButton"
                                    Content="📥 اختيار ملف CSV واستيراد الأدوية"
                                    Width="280"
                                    Height="43"
                                    HorizontalAlignment="Right"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ImportDrugCatalogButton_Click"/>

                            <TextBlock x:Name="DrugCatalogImportStatusText"
                                       Text="لم يتم استيراد ملف حتى الآن."
                                       Foreground="#475569"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- إعادة ضبط البيانات التجريبية -->
                    <Separator Margin="0,25,0,20"/>

                    <Border Background="#FFF1F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18">

                        <StackPanel>

                            <TextBlock Text="إعادة ضبط البيانات التجريبية"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#B91C1C"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="هذا الإجراء يحذف الأصناف والمخزون والتشغيلات وفواتير البيع والشراء والمرتجعات التجريبية."
                                       Foreground="#7F1D1D"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <TextBlock Text="سيتم الاحتفاظ بالمستخدمين والصلاحيات وإعدادات الصيدلية والطابعة وسجل العمليات. وسيتم إنشاء نسخة احتياطية تلقائيًا قبل الحذف."
                                       Foreground="#7F1D1D"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,15"/>

                            <Button x:Name="ClearTestDataButton"
                                    Content="🗑 إعادة ضبط البيانات التجريبية"
                                    Width="250"
                                    Height="43"
                                    HorizontalAlignment="Right"
                                    Background="#DC2626"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="ClearTestDataButton_Click"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>

        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,15,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="SaveSettingsButton"
                        Content="💾 حفظ الإعدادات"
                        Width="160"
                        Height="42"
                        Background="#16865D"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,10,0"
                        Click="SaveSettingsButton_Click"/>

                <Button Content="إغلاق"
                        Width="110"
                        Height="42"
                        Background="#64748B"
                        Foreground="White"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>
