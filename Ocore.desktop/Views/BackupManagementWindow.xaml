<Window x:Class="Ocore.desktop.Views.BackupManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - النسخ الاحتياطي والاستعادة"
        Height="600"
        Width="950"
        MinHeight="500"
        MinWidth="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F5F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="النسخ الاحتياطي واستعادة البيانات"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#243447"/>

                <TextBlock Text="إدارة النسخ الاحتياطية لقاعدة بيانات الصيدلية وحماية بياناتك"
                           FontSize="13"
                           Foreground="#718096"
                           Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <!-- معلومات وتنبيهات -->
        <Border Grid.Row="1"
                Background="#E8F1FC"
                BorderBrush="#BBD5F2"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="معلومات مهمة"
                           FontWeight="Bold"
                           Foreground="#24558A"
                           FontSize="14"/>

                <TextBlock Text="• اختر نسخة احتياطية سليمة من القائمة لاستعادتها."
                           Margin="0,7,0,0"
                           Foreground="#34516F"/>

                <TextBlock Text="• لن يتم استبدال قاعدة البيانات الحالية أثناء تشغيل البرنامج."
                           Margin="0,4,0,0"
                           Foreground="#34516F"/>

                <TextBlock Text="• بعد تجهيز الاستعادة، أغلق البرنامج وافتحه مرة أخرى لإتمام العملية."
                           Margin="0,4,0,0"
                           Foreground="#34516F"/>
            </StackPanel>
        </Border>

        <!-- جدول النسخ الاحتياطية -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DCE2E8"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">

                    <TextBlock Text="النسخ الاحتياطية المتاحة"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#243447"
                               VerticalAlignment="Center"/>

                    <Button x:Name="RefreshBackupsButton"
                            Content="⟳  تحديث القائمة"
                            Width="125"
                            Height="34"
                            DockPanel.Dock="Left"
                            Background="#EDF2F7"
                            Foreground="#334155"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </DockPanel>

                <DataGrid x:Name="BackupsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38"
                          ColumnHeaderHeight="40"
                          Background="White"
                          BorderThickness="0"
                          HorizontalGridLinesBrush="#E8EDF2"
                          VerticalGridLinesBrush="#E8EDF2"
                          FlowDirection="RightToLeft">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="اسم النسخة"
                                            Binding="{Binding FileName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="تاريخ الإنشاء"
                                            Binding="{Binding CreationDate}"
                                            Width="1.5*"/>

                        <DataGridTextColumn Header="حجم النسخة"
                                            Binding="{Binding FileSize}"
                                            Width="*"/>

                        <DataGridTextColumn Header="نوع النسخة"
                                            Binding="{Binding BackupType}"
                                            Width="1.2*"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- حالة الاختيار -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                Padding="12"
                Margin="0,15,0,15">

            <TextBlock x:Name="BackupStatusText"
                       Text="اختر نسخة احتياطية من الجدول لعرض تفاصيلها."
                       Foreground="#64748B"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- الأزرار -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="CloseButton"
                    Grid.Column="0"
                    Content="إغلاق"
                    Width="100"
                    Height="40"
                    HorizontalAlignment="Right"
                    Background="#E2E8F0"
                    Foreground="#334155"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button x:Name="ExportDataButton"
                    Grid.Column="1"
                    Content="تصدير البيانات"
                    Width="145"
                    Height="40"
                    Margin="5,0"
                    Background="#256D85"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button x:Name="ImportDataButton"
                    Grid.Column="2"
                    Content="استرداد نسخة خارجية"
                    Width="165"
                    Height="40"
                    Margin="5,0"
                    Background="#475569"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"/>

            <Button x:Name="RestoreBackupButton"
                    Grid.Column="3"
                    Content="استعادة النسخة المحددة"
                    Width="190"
                    Height="40"
                    Margin="5,0"
                    Background="#D97706"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Cursor="Hand"
                    IsEnabled="False"/>

        </Grid>
    </Grid>
</Window>
