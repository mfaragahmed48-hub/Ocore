<Window x:Class="Ocore.desktop.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - تعديل المستخدم"
        Height="400"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="تعديل بيانات المستخدم"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#183F36"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">

            <TextBlock Text="الاسم الكامل"
                       Margin="0,5"/>

            <TextBox x:Name="FullNameBox"
                     Height="38"
                     FontSize="15"
                     Padding="8"/>

            <TextBlock Text="نوع المستخدم"
                       Margin="0,15,0,5"/>

            <ComboBox x:Name="RoleComboBox"
                      Height="38"
                      FontSize="15"
                      SelectedIndex="0">

                <ComboBoxItem Content="صيدلي"
                              Tag="Pharmacist"/>

                <ComboBoxItem Content="كاشير"
                              Tag="Cashier"/>

            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left">

            <Button Content="حفظ التعديلات"
                    Width="140"
                    Height="40"
                    Margin="5"
                    Background="#16865D"
                    Foreground="White"
                    Click="SaveButton_Click"/>

            <Button Content="إلغاء"
                    Width="100"
                    Height="40"
                    Margin="5"
                    Click="CancelButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
