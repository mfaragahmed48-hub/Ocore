<Window x:Class="Ocore.desktop.Views.PurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - فاتورة شراء جديدة"
        Height="680"
        Width="1100"
        MinHeight="450"
        MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F1F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#174C43"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#16865D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263A36"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#71817C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE5E1"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EAF0EE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FCEEEE"/>
            <Setter Property="Foreground" Value="#A83232"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1EE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- الشاشة الرئيسية: الأجزاء ثابتة والجدول وحده يتمرر -->
    <Grid Margin="10"
          MinWidth="1050">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس الشاشة -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="9"
                Padding="12"
                Margin="0,0,0,8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="فاتورة شراء جديدة"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="تسجيل فاتورة المورد وإضافة الأصناف إلى المخزون"
                               FontSize="10"
                               Foreground="#D5E7E1"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        Opacity="0.14"
                        CornerRadius="7"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="O CORE"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- بيانات المورد والفاتورة: ثابتة -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="9"
                Margin="0,0,0,8">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="المورد" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SupplierComboBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              IsTextSearchEnabled="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="InvoiceDatePicker"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="نوع المستند" Style="{StaticResource FieldLabel}"/>
                    <Border Background="#F2F6F4"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="32"
                            Padding="8,0">
                        <TextBlock Text="فاتورة شراء"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- إضافة صنف: ثابتة -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="9"
                Margin="0,0,0,8">

            <StackPanel>
                <DockPanel Margin="3,0,3,7">
                    <TextBlock Text="إضافة صنف إلى الفاتورة"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock DockPanel.Dock="Left"
                               Text="بيانات الصنف والتشغيلة"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="3">
                        <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProductComboBox"
                                      Grid.Column="0"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Name"/>

                            <Button Grid.Column="1"
                                    Content="+ صنف جديد"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10"
                                    Padding="3,2"
                                    Click="AddNewProductButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="3">
                        <TextBlock Text="رقم التشغيلة" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BatchNumberTextBox"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="3">
                        <TextBlock Text="تاريخ الصلاحية" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ExpiryDatePicker"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="3">
                        <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="QuantityTextBox"
                                 Text="1"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="3">
                        <TextBlock Text="وحدة الشراء" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PurchaseUnitComboBox"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="3">
                        <TextBlock Text="سعر شراء الوحدة" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UnitPriceTextBox"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- سعر البيع المسجل في الأصناف والمخزن: للعرض فقط -->
                    <StackPanel Grid.Column="2" Margin="3">
                        <TextBlock Text="سعر البيع الحالي" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SalePriceTextBox"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Background="#F2F6F4"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 FontWeight="Bold"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="إضافة إلى الفاتورة"
                            Width="140"
                            Margin="5,17,3,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddItemButton_Click"/>

                    <Button Grid.Column="4"
                            x:Name="RemoveItemButton"
                            Content="حذف الصنف المحدد"
                            Width="130"
                            Margin="3,17,3,0"
                            Style="{StaticResource DangerButton}"
                            Click="RemoveItemButton_Click"/>
                </Grid>

                <TextBlock Text="يمكن تعديل الكمية والوحدة والمجاني والخصم والضريبة مباشرة داخل الجدول قبل الحفظ."
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="3,6,3,0"/>
            </StackPanel>
        </Border>

        <!-- جدول الأصناف: هو الجزء القابل للتمرير -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="7"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="3,0,3,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="أصناف الفاتورة"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="يمكن تعديل بيانات البنود قبل الحفظ"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="InvoiceItemsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="32"
                          FontSize="11"
                          Background="White"
                          Foreground="{StaticResource TextBrush}"
                          BorderThickness="0"
                          HorizontalGridLinesBrush="#E9EFEC"
                          AlternatingRowBackground="#F6F9F7"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AlternationCount="10000"
                          RowEditEnding="InvoiceItemsGrid_RowEditEnding">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="م" Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" IsReadOnly="True" Width="160"/>
                        <DataGridTextColumn Header="الشركة" Binding="{Binding Manufacturer}" IsReadOnly="True" Width="110"/>

                        <DataGridTemplateColumn Header="الوحدة" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableUnits}"
                                              SelectedItem="{Binding UnitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False"
                                              IsTextSearchEnabled="True"
                                              VerticalContentAlignment="Center"
                                              Padding="3,1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="رقم التشغيلة" Binding="{Binding BatchNumber}" IsReadOnly="True" Width="95"/>

                        <DataGridTemplateColumn Header="الصلاحية" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpiryDateText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ExpiryDate,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                FontSize="11"
                                                Height="26"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="المجاني" Binding="{Binding FreeQuantity, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="وحدات/عبوة" Binding="{Binding UnitsPerPackage}" IsReadOnly="True" Width="75"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="80"/>
                        <DataGridTextColumn Header="خصم %" Binding="{Binding DiscountPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="قيمة الخصم" Binding="{Binding DiscountAmount, StringFormat=N2}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="بعد الخصم" Binding="{Binding DiscountedUnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="ضريبة %" Binding="{Binding TaxPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="قيمة الضريبة" Binding="{Binding TaxAmount, StringFormat=N2}" IsReadOnly="True" Width="80"/>
                        <DataGridTextColumn Header="صافي الوحدة" Binding="{Binding NetUnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- إجمالي الفاتورة وأزرار التحكم: ثابتة -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="9"
                Margin="0,8,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي فاتورة الشراء"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock x:Name="TotalTextBlock"
                               Text="0.00 جنيه"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="حفظ فاتورة الشراء"
                        Width="155"
                        Height="38"
                        Margin="4"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="13"
                        Click="SaveInvoiceButton_Click"/>

                <Button Grid.Column="2"
                        Content="إغلاق"
                        Width="85"
                        Height="38"
                        Margin="4"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
