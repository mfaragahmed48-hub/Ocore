<Window x:Class="Ocore.desktop.Views.PurchaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - فاتورة شراء جديدة"
        Height="780"
        Width="1250"
        MinHeight="550"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F1F4F6"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#174C43"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#16865D"/>
        <SolidColorBrush x:Key="TextBrush" Color="#263A36"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#71817C"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE5E1"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="29"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="31"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EAF0EE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FCEEEE"/>
            <Setter Property="Foreground" Value="#A83232"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1EE"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="7"
          MinWidth="0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- رأس الشاشة -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="8"
                Padding="8"
                Margin="0,0,0,5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="فاتورة شراء جديدة"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="تسجيل فاتورة المورد وإضافة الأصناف إلى المخزون"
                               FontSize="9"
                               Foreground="#D5E7E1"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#FFFFFF"
                        Opacity="0.14"
                        CornerRadius="7"
                        Padding="9,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="O CORE"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="Bold"/>
                </Border>
            </Grid>
        </Border>

        <!-- بيانات المورد والفاتورة والباركود -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="6"
                Margin="0,0,0,5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="2">
                    <TextBlock Text="المورد" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="SupplierComboBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              IsTextSearchEnabled="True"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="2">
                    <TextBlock Text="تاريخ الفاتورة" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="InvoiceDatePicker"
                                SelectedDateFormat="Short"/>
                </StackPanel>

                <!-- منطقة مسح الباركود في مكان نوع المستند -->
                <Border Grid.Column="2"
                        Background="#F7FAF8"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="5,3"
                        Margin="3,0,2,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="مسح الباركود الدولي"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,0,0,3"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="BarcodeScanTextBox"
                                     Grid.Column="0"
                                     Height="29"
                                     MinWidth="100"
                                     ToolTip="امسح الباركود باستخدام قارئ USB"
                                     KeyDown="BarcodeScanTextBox_KeyDown"/>

                            <Button x:Name="ReadBarcodeButton"
                                    Grid.Column="1"
                                    Content="قراءة"
                                    Width="58"
                                    Height="29"
                                    Margin="3,0,0,0"
                                    Padding="3,1"
                                    FontSize="10"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="ReadBarcodeButton_Click"/>

                            <Button x:Name="LinkPendingBarcodeButton"
                                    Grid.Column="2"
                                    Content="ربط الصنف"
                                    Width="75"
                                    Height="29"
                                    Margin="3,0,0,0"
                                    Padding="3,1"
                                    FontSize="10"
                                    Style="{StaticResource SecondaryButton}"
                                    IsEnabled="False"
                                    Click="LinkPendingBarcodeButton_Click"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="BarcodeStatusTextBlock"
                                   Text="امسح الباركود للتعرف على الصنف والتشغيلة والصلاحية."
                                   FontSize="8"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,32,0,0"
                                   TextWrapping="Wrap"
                                   MaxHeight="25"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- إضافة صنف -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="6"
                Margin="0,0,0,5">

            <StackPanel>

                <DockPanel Margin="2,0,2,4">
                    <TextBlock Text="إضافة صنف إلى الفاتورة"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <TextBlock DockPanel.Dock="Left"
                               Text="بيانات الصنف والتشغيلة"
                               FontSize="9"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="2">
                        <TextBlock Text="الصنف" Style="{StaticResource FieldLabel}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProductComboBox"
                                      Grid.Column="0"
                                      IsEditable="True"
                                      IsReadOnly="False"
                                      IsTextSearchEnabled="False"
                                      StaysOpenOnEdit="True"
                                      TextSearch.TextPath="Name"
                                      SelectedValuePath="Id"
                                      MaxDropDownHeight="280">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Bold"
                                                       FontSize="12"/>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="الكود: "
                                                           FontSize="10"
                                                           Foreground="Gray"/>
                                                <TextBlock Text="{Binding ProductCode}"
                                                           FontSize="10"
                                                           Margin="0,0,12,0"/>

                                                <TextBlock Text="سعر البيع: "
                                                           FontSize="10"
                                                           Foreground="Gray"/>
                                                <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2}}"
                                                           FontSize="10"
                                                           Margin="0,0,12,0"/>

                                                <TextBlock Text="سعر الشراء: "
                                                           FontSize="10"
                                                           Foreground="Gray"/>
                                                <TextBlock Text="{Binding PurchasePrice, StringFormat={}{0:N2}}"
                                                           FontSize="10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Grid.Column="1"
                                    Content="+ صنف جديد"
                                    Margin="3,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="10"
                                    Padding="3,2"
                                    Click="AddNewProductButton_Click"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="2">
                        <TextBlock Text="رقم التشغيلة" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="BatchNumberTextBox"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="2">
                        <TextBlock Text="تاريخ الصلاحية" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="ExpiryDatePicker"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="2">
                        <TextBlock Text="الكمية" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="QuantityTextBox"
                                 Text="1"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,3,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="2">
                        <TextBlock Text="وحدة الشراء" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="PurchaseUnitComboBox"
                                  IsEnabled="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="2">
                        <TextBlock Text="سعر شراء الوحدة" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UnitPriceTextBox"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="2">
                        <TextBlock Text="سعر البيع الحالي" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="SalePriceTextBox"
                                 IsReadOnly="True"
                                 IsTabStop="False"
                                 Background="#F2F6F4"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 FontWeight="Bold"
                                 HorizontalContentAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="إضافة إلى الفاتورة"
                            Width="135"
                            Margin="4,14,2,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddItemButton_Click"/>

                    <Button Grid.Column="4"
                            x:Name="RemoveItemButton"
                            Content="حذف الصنف المحدد"
                            Width="120"
                            Margin="2,14,2,0"
                            Style="{StaticResource DangerButton}"
                            Click="RemoveItemButton_Click"/>
                </Grid>

                <TextBlock Text="يمكن تعديل الكمية والوحدة والمجاني والخصم مباشرة داخل الجدول قبل الحفظ."
                           FontSize="9"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="2,3,2,0"/>
            </StackPanel>
        </Border>

        <!-- جدول الأصناف: يأخذ المساحة المتبقية -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="5"
                ClipToBounds="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="2,0,2,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="أصناف الفاتورة"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="فاتورة شراء - يمكن تعديل بيانات البنود قبل الحفظ"
                               FontSize="9"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <DataGrid x:Name="InvoiceItemsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          CanUserResizeColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="30"
                          FontSize="11"
                          Background="White"
                          Foreground="{StaticResource TextBrush}"
                          BorderThickness="0"
                          HorizontalGridLinesBrush="#E9EFEC"
                          AlternatingRowBackground="#F6F9F7"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          AlternationCount="10000"
                          RowEditEnding="InvoiceItemsGrid_RowEditEnding">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="م" Width="40" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" IsReadOnly="True" Width="90"/>
                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ItemName}" IsReadOnly="True" Width="160"/>
                        <DataGridTextColumn Header="الشركة" Binding="{Binding Manufacturer}" IsReadOnly="True" Width="110"/>

                        <DataGridTemplateColumn Header="الوحدة" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitName}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding AvailableUnits}"
                                              SelectedItem="{Binding UnitName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="False"
                                              IsTextSearchEnabled="True"
                                              VerticalContentAlignment="Center"
                                              Padding="3,1"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="رقم التشغيلة" Binding="{Binding BatchNumber}" IsReadOnly="True" Width="95"/>

                        <DataGridTemplateColumn Header="الصلاحية" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ExpiryDateText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <DatePicker SelectedDate="{Binding ExpiryDate,
                                                                        Mode=TwoWay,
                                                                        UpdateSourceTrigger=PropertyChanged}"
                                                SelectedDateFormat="Short"
                                                FontSize="11"
                                                Height="26"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="المجاني" Binding="{Binding FreeQuantity, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>
                        <DataGridTextColumn Header="وحدات/عبوة" Binding="{Binding UnitsPerPackage}" IsReadOnly="True" Width="75"/>
                        <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="80"/>

                        <DataGridTextColumn Header="خصم %" Binding="{Binding DiscountPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="65"/>

                        <DataGridTextColumn Header="ضريبة %" Binding="{Binding TaxPercent, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="70"/>

                        <DataGridTextColumn Header="قيمة الخصم" Binding="{Binding DiscountAmount, StringFormat=N2}" IsReadOnly="True" Width="80"/>

                        <DataGridTextColumn Header="بعد الخصم" Binding="{Binding DiscountedUnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>

                        <DataGridTextColumn Header="قيمة الضريبة" Binding="{Binding TotalTaxAmount, StringFormat=N2}" IsReadOnly="True" Width="90"/>

                        <DataGridTextColumn Header="صافي الوحدة" Binding="{Binding NetUnitPrice, StringFormat=N2}" IsReadOnly="True" Width="85"/>

                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding Total, StringFormat=N2}" IsReadOnly="True" Width="85"/>
                        <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- إجمالي الفاتورة وأزرار التحكم -->
        <Border Grid.Row="4"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="6"
                Margin="0,5,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي فاتورة الشراء"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}"/>

                    <TextBlock x:Name="TotalTextBlock"
                               Text="0.00 جنيه"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="حفظ فاتورة الشراء"
                        Width="150"
                        Height="34"
                        Margin="3"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="12"
                        Click="SaveInvoiceButton_Click"/>

                <Button Grid.Column="2"
                        Content="إغلاق"
                        Width="80"
                        Height="34"
                        Margin="3"
                        Style="{StaticResource SecondaryButton}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
