<Window x:Class="Ocore.desktop.Views.SaleInvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - تفاصيل فاتورة البيع"
        Height="720"
        Width="1250"
        MinHeight="580"
        MinWidth="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <DockPanel>
                <TextBlock Text="📄   تفاصيل فاتورة البيع"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="O CORE"
                           DockPanel.Dock="Left"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#16865D"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="8">
                    <TextBlock Text="رقم الفاتورة"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="InvoiceNumberText"
                               Text="-"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#183F36"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="8">
                    <TextBlock Text="اسم الموظف"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="EmployeeNameText"
                               Text="-"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#183F36"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="8">
                    <TextBlock Text="العميل"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="CustomerNameText"
                               Text="عميل نقدي"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#183F36"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="8">
                    <TextBlock Text="تاريخ الفاتورة"
                               Foreground="#64736F"
                               Margin="0,0,0,5"/>
                    <TextBlock x:Name="InvoiceDateText"
                               Text="-"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#183F36"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="InvoiceItemsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="42"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F3F7F5"
                      RowDetailsVisibilityMode="Visible">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف"
                                        Binding="{Binding ItemName}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="الوحدة"
                                        Binding="{Binding UnitName}"
                                        Width="0.8*"/>

                    <DataGridTextColumn Header="الكمية"
                                        Binding="{Binding Quantity, StringFormat=N2}"
                                        Width="0.8*"/>

                    <DataGridTextColumn Header="سعر الوحدة"
                                        Binding="{Binding UnitPrice, StringFormat=N2}"
                                        Width="1*"/>

                    <DataGridTextColumn Header="الإجمالي قبل الخصم"
                                        Binding="{Binding Total, StringFormat=N2}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="الخصم اليدوي %"
                                        Binding="{Binding DiscountPercentage, StringFormat=N2}"
                                        Width="1.1*"/>

                    <DataGridTextColumn Header="إجمالي الخصم"
                                        Binding="{Binding DiscountAmount, StringFormat=N2}"
                                        Width="1.1*"/>

                    <DataGridTextColumn Header="الصافي"
                                        Binding="{Binding NetTotal, StringFormat=N2}"
                                        Width="1.1*"/>
                </DataGrid.Columns>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F1F7F4"
                                BorderBrush="#D5E5DC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="8,3,8,8">

                            <StackPanel>
                                <TextBlock Text="تفاصيل التشغيلات المصروفة"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           Foreground="#183F36"
                                           Margin="0,0,0,8"/>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Row="0"
                                            Grid.ColumnSpan="3"
                                            Background="#DCEBE2"
                                            Padding="7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="رقم التشغيلة"
                                                       FontWeight="Bold"
                                                       Foreground="#183F36"/>

                                            <TextBlock Grid.Column="1"
                                                       Text="تاريخ الصلاحية"
                                                       FontWeight="Bold"
                                                       Foreground="#183F36"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="الكمية المصروفة"
                                                       FontWeight="Bold"
                                                       Foreground="#183F36"/>
                                        </Grid>
                                    </Border>

                                    <ItemsControl Grid.Row="1"
                                                  Grid.ColumnSpan="3"
                                                  ItemsSource="{Binding BatchAllocations}">

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E2E8E5"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding BatchNumber,
                                                            TargetNullValue='بدون رقم تشغيلة'}"
                                                                   Foreground="#33433C"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding ExpiryDate,
                                                                    TargetNullValue='بدون تاريخ'}"
                                                                   Foreground="#33433C"
                                                                   VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding AllocatedQuantity,
                                                                    StringFormat=N2}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#16865D"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

            </DataGrid>
        </Border>

        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="إجمالي الأصناف:"
                                   Foreground="#64736F"/>
                        <TextBlock x:Name="SubtotalText"
                                   Grid.Column="1"
                                   Text="0.00"
                                   FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="إجمالي الخصومات:"
                                   Foreground="#64736F"/>
                        <TextBlock x:Name="DiscountAmountText"
                                   Grid.Column="1"
                                   Text="0.00"
                                   Foreground="#B45309"
                                   FontWeight="Bold"/>
                    </Grid>

                    <Separator Margin="0,5"/>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="صافي الفاتورة:"
                                   FontWeight="Bold"
                                   Foreground="#183F36"/>
                        <TextBlock x:Name="NetTotalText"
                                   Grid.Column="1"
                                   Text="0.00"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#16865D"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="المدفوع:"
                                   Foreground="#64736F"/>
                        <TextBlock x:Name="PaidAmountText"
                                   Grid.Column="1"
                                   Text="0.00"
                                   FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="المتبقي:"
                                   Foreground="#64736F"/>
                        <TextBlock x:Name="RemainingAmountText"
                                   Grid.Column="1"
                                   Text="0.00"
                                   FontWeight="Bold"
                                   Foreground="#B45309"/>
                    </Grid>

                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="حالة السداد:"
                                   Foreground="#64736F"/>
                        <TextBlock x:Name="PaymentStatusText"
                                   Grid.Column="1"
                                   Text="-"
                                   FontWeight="Bold"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="⚙ إعدادات الطابعة"
                            Width="155"
                            Height="38"
                            Margin="5"
                            Background="#315A78"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="PrinterSettingsButton_Click"/>

                    <Button Content="🖨 طباعة الفاتورة"
                            Width="160"
                            Height="38"
                            Margin="5"
                            Background="#16865D"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="PrintInvoiceButton_Click"/>

                    <Button Content="إغلاق"
                            Width="90"
                            Height="38"
                            Margin="5"
                            Background="#246B58"
                            Foreground="White"
                            FontWeight="Bold"
                            BorderThickness="0"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
