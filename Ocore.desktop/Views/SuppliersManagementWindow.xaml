<Window x:Class="Ocore.desktop.Views.SuppliersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - إدارة الموردين"
        Height="620"
        Width="950"
        MinHeight="500"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10">

            <StackPanel>
                <TextBlock Text="إدارة الموردين"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="إضافة ومتابعة بيانات موردي الصيدلية"
                           FontSize="13"
                           Foreground="#64736F"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- نموذج إضافة وتعديل المورد -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock x:Name="FormTitleTextBlock"
                           Text="إضافة مورد جديد"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#183F36"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="5">

                        <TextBlock Text="اسم المورد *"/>

                        <TextBox x:Name="SupplierNameTextBox"
                                 Height="35"
                                 Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="5">

                        <TextBlock Text="رقم الهاتف"/>

                        <TextBox x:Name="SupplierPhoneTextBox"
                                 Height="35"
                                 Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="5">

                        <TextBlock Text="العنوان"/>

                        <TextBox x:Name="SupplierAddressTextBox"
                                 Height="35"
                                 Margin="0,5"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button x:Name="SaveSupplierButton"
                                Content="➕ إضافة المورد"
                                Width="150"
                                Height="38"
                                Margin="5"
                                Background="#16865D"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="SaveSupplier_Click"/>

                        <Button x:Name="CancelEditButton"
                                Content="إلغاء التعديل"
                                Width="120"
                                Height="38"
                                Margin="5"
                                Visibility="Collapsed"
                                Click="CancelEdit_Click"/>
                    </StackPanel>

                </Grid>
            </StackPanel>
        </Border>

        <!-- جدول الموردين -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12">

            <DockPanel>

                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,10">

                    <TextBlock Text="الموردون المسجلون"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#183F36"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="35"
                                 Margin="5"
                                 VerticalContentAlignment="Center"
                                 ToolTip="ابحث باسم المورد أو رقم الهاتف"
                                 TextChanged="SearchTextBox_TextChanged"/>

                        <ComboBox x:Name="SupplierFilterComboBox"
                                  Grid.Column="1"
                                  Height="35"
                                  Margin="5"
                                  SelectedIndex="0"
                                  SelectionChanged="SupplierFilterComboBox_SelectionChanged">

                            <ComboBoxItem Content="الموردون النشطون"/>
                            <ComboBoxItem Content="كل الموردين"/>
                        </ComboBox>

                        <Button Grid.Column="2"
                                Content="تحديث"
                                Width="80"
                                Height="35"
                                Margin="5"
                                Click="RefreshButton_Click"/>
                    </Grid>

                </StackPanel>

                <DataGrid x:Name="SuppliersDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          FlowDirection="RightToLeft"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="الرقم"
                                            Binding="{Binding Id}"
                                            Width="60"/>

                        <DataGridTextColumn Header="اسم المورد"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="رقم الهاتف"
                                            Binding="{Binding Phone}"
                                            Width="130"/>

                        <DataGridTextColumn Header="العنوان"
                                            Binding="{Binding Address}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الحالة"
                                            Binding="{Binding StatusText}"
                                            Width="80"/>

                        <DataGridTemplateColumn Header="التحكم"
                                                Width="190">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">

                                        <Button Content="تعديل"
                                                Padding="8,4"
                                                Margin="3"
                                                Background="#1976D2"
                                                Foreground="White"
                                                Click="EditSupplier_Click"/>

                                        <Button Content="تغيير الحالة"
                                                Padding="8,4"
                                                Margin="3"
                                                Click="ChangeSupplierStatus_Click"/>

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </DockPanel>
        </Border>

    </Grid>
</Window>
