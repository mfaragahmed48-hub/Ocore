<Window x:Class="Ocore.desktop.Views.ManagerAccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - بيانات حساب المدير"
        Height="620"
        Width="650"
        MinHeight="580"
        MinWidth="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="بيانات حساب المدير"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#183F36"/>

            <TextBlock Text="يمكنك تغيير اسم الدخول والاسم الظاهر وكلمة المرور."
                       FontSize="13"
                       Foreground="#64736F"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                Padding="22">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <TextBlock Text="بيانات الحساب"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#16865D"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="اسم الدخول الجديد"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UsernameTextBox"
                             Height="38"
                             Padding="8"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                    <TextBlock Text="الاسم الظاهر في البرنامج"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="FullNameTextBox"
                             Height="38"
                             Padding="8"
                             FontSize="14"
                             Margin="0,0,0,20"/>

                    <Separator Margin="0,0,0,18"/>

                    <TextBlock Text="تأكيد الهوية وتغيير كلمة المرور"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#16865D"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="كلمة المرور الحالية"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="CurrentPasswordBox"
                                 Height="38"
                                 Padding="8"
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                    <TextBlock Text="كلمة المرور الجديدة"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="NewPasswordBox"
                                 Height="38"
                                 Padding="8"
                                 FontSize="14"
                                 Margin="0,0,0,15"/>

                    <TextBlock Text="تأكيد كلمة المرور الجديدة"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Height="38"
                                 Padding="8"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                    <TextBlock Text="لا يوجد حد أدنى أو أقصى محدد لطول كلمة المرور.."
                               TextWrapping="Wrap"
                               Foreground="#64736F"
                               FontSize="12"/>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,18,0,0">

            <Button Content="حفظ التغييرات"
                    Width="145"
                    Height="42"
                    Background="#16865D"
                    Foreground="White"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Margin="0,0,10,0"
                    Click="SaveButton_Click"/>

            <Button Content="إلغاء"
                    Width="100"
                    Height="42"
                    Background="#E5E9E8"
                    Foreground="#183F36"
                    BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
