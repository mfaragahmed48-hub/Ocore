<Window x:Class="Ocore.desktop.Views.SalesReturnsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - سجل مرتجعات البيع"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F6FA">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,15">

            <StackPanel>
                <TextBlock Text="سجل مرتجعات البيع"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1E293B"/>

                <TextBlock Text="متابعة ومراجعة جميع عمليات مرتجعات البيع"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- البحث والتصفية -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="بحث"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="34"
                             FontSize="14"
                             Padding="7"
                             VerticalContentAlignment="Center"
                             ToolTip="رقم المرتجع أو الفاتورة أو الموظف أو السبب"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="من تاريخ"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="FromDatePicker"
                                Height="34"
                                FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="إلى تاريخ"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <DatePicker x:Name="ToDatePicker"
                                Height="34"
                                FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="6"
                        x:Name="SearchButton"
                        Content="بحث"
                        Width="75"
                        Height="34"
                        Margin="0,22,0,0"
                        Background="#2563EB"
                        Foreground="White"
                        FontWeight="Bold"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="8"
                        x:Name="ResetButton"
                        Content="إعادة ضبط"
                        Width="90"
                        Height="34"
                        Margin="0,22,0,0"
                        Background="#E2E8F0"
                        Foreground="#334155"
                        Click="ResetButton_Click"/>
            </Grid>
        </Border>

        <!-- ملخص المرتجعات -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="عدد المرتجعات"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock x:Name="ReturnsCountText"
                               Text="0"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>
                    <TextBlock Text="إجمالي قيمة المرتجعات"
                               Foreground="#64748B"
                               FontSize="13"/>

                    <TextBlock x:Name="ReturnsTotalText"
                               Text="0.00 ج.م"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#DC2626"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- جدول المرتجعات -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="ReturnsDataGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="38"
                      FontSize="13"
                      Background="White"
                      BorderThickness="0"
                      AlternatingRowBackground="#F8FAFC"
                      MouseDoubleClick="ReturnsDataGrid_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="رقم المرتجع"
                                        Binding="{Binding ReturnNumber}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="رقم الفاتورة"
                                        Binding="{Binding InvoiceNumber}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="الموظف"
                                        Binding="{Binding EmployeeName}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="التاريخ"
                                        Binding="{Binding CreatedAt}"
                                        Width="1.3*"/>

                    <DataGridTextColumn Header="الإجمالي"
                                        Binding="{Binding Total, StringFormat={}{0:N2}}"
                                        Width="1*"/>

                    <DataGridTextColumn Header="السبب"
                                        Binding="{Binding Reason}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="الحالة"
                                        Binding="{Binding Status}"
                                        Width="0.8*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- الحالة والإغلاق -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Text="جاهز"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       FontSize="12"/>

            <Button Grid.Column="1"
                    Content="إغلاق"
                    Width="100"
                    Height="35"
                    Background="#334155"
                    Foreground="White"
                    Click="CloseButton_Click"/>
        </Grid>

    </Grid>
</Window>
