<Window x:Class="Ocore.desktop.Views.SalesReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تقارير المبيعات - O CORE"
        Height="850"
        Width="1200"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F5F9">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Grid Margin="18">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="18"
                Margin="0,0,0,12">

            <DockPanel>

                <StackPanel>
                    <TextBlock Text="تقارير المبيعات"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#1E293B"/>

                    <TextBlock Text="تحليل المبيعات والأرباح وأداء الموظفين"
                               FontSize="12"
                               Foreground="#64748B"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <TextBlock Text="O CORE"
                           DockPanel.Dock="Left"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           VerticalAlignment="Center"/>

            </DockPanel>
        </Border>

        <!-- اختيار الفترة -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="من تاريخ:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"/>

                <DatePicker x:Name="FromDatePicker"
                            Width="145"
                            Height="32"
                            Margin="0,0,20,0"/>

                <TextBlock Text="إلى تاريخ:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="SemiBold"/>

                <DatePicker x:Name="ToDatePicker"
                            Width="145"
                            Height="32"
                            Margin="0,0,20,0"/>

                <Button x:Name="LoadReportButton"
                        Content="عرض التقرير"
                        Style="{StaticResource PrimaryButton}"
                        Click="LoadReportButton_Click"/>

            </StackPanel>
        </Border>

        <!-- محتوى التقارير القابل للتمرير -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>

                <!-- بطاقات الملخص -->
                <Grid Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="إجمالي المبيعات الصافي"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="TotalSalesText"
                                       Text="0.00 ج.م"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="عدد الفواتير"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="InvoiceCountText"
                                       Text="0"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#334155"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="تكلفة البضاعة المباعة"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="TotalCostText"
                                       Text="0.00 ج.م"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#D97706"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="صافي الربح"
                                       Foreground="#64748B"
                                       FontSize="13"/>

                            <TextBlock x:Name="NetProfitText"
                                       Text="0.00 ج.م"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>

                <!-- الرسم البياني -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="18"
                        Margin="6,0,6,12">

                    <StackPanel>

                        <TextBlock Text="حركة المبيعات اليومية"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"/>

                        <TextBlock Text="صافي قيمة المبيعات لكل يوم بعد الخصومات"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,5,0,12"/>

                        <Border Background="#F8FAFC"
                                CornerRadius="8"
                                Padding="10">

                            <Grid Height="250">

                                <Canvas x:Name="DailySalesChartCanvas"
                                        ClipToBounds="True"
                                        Background="Transparent"/>

                                <TextBlock x:Name="DailySalesEmptyText"
                                           Text="لا توجد مبيعات خلال الفترة المحددة"
                                           Foreground="#94A3B8"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Visible"/>

                            </Grid>

                        </Border>

                    </StackPanel>
                </Border>

                <!-- أفضل الأصناف -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="6,0,6,12">

                    <DockPanel>

                        <TextBlock Text="أفضل 10 أصناف مبيعًا حسب الكمية"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="قيمة المبيعات الموضحة هي الصافي بعد الخصومات"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="TopProductsDataGrid"
                                  Style="{StaticResource DataGridStyle}"
                                  Height="250">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="كود الصنف"
                                                    Binding="{Binding ProductId}"
                                                    Width="100"/>

                                <DataGridTextColumn Header="اسم الصنف"
                                                    Binding="{Binding ProductName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="الكمية المباعة"
                                                    Binding="{Binding TotalQuantity, StringFormat=N2}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="صافي المبيعات"
                                                    Binding="{Binding TotalSales, StringFormat=N2}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="عدد الفواتير"
                                                    Binding="{Binding InvoiceCount}"
                                                    Width="120"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </DockPanel>
                </Border>

                <!-- أداء الموظفين -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="6,0,6,12">

                    <DockPanel>

                        <TextBlock Text="أداء الموظفين"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#1E293B"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="المبيعات ومتوسط الفاتورة بعد الخصومات"
                                   FontSize="11"
                                   Foreground="#64748B"
                                   DockPanel.Dock="Top"
                                   Margin="0,0,0,12"/>

                        <DataGrid x:Name="EmployeesDataGrid"
                                  Style="{StaticResource DataGridStyle}"
                                  Height="250">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="اسم الموظف"
                                                    Binding="{Binding EmployeeName}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="عدد الفواتير"
                                                    Binding="{Binding InvoiceCount}"
                                                    Width="150"/>

                                <DataGridTextColumn Header="صافي المبيعات"
                                                    Binding="{Binding TotalSales, StringFormat=N2}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="متوسط الفاتورة"
                                                    Binding="{Binding AverageInvoiceValue, StringFormat=N2}"
                                                    Width="180"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </DockPanel>
                </Border>

                <!-- حالة التقرير -->
                <TextBlock x:Name="ReportStatusText"
                           Text="حدد الفترة الزمنية ثم اضغط عرض التقرير"
                           Foreground="#64748B"
                           FontSize="12"
                           Margin="8,0,8,12"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>
