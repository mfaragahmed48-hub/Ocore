<Window x:Class="Ocore.desktop.Views.CustomersManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - إدارة العملاء"
        Height="700"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="إدارة العملاء"
                           FontSize="23"
                           FontWeight="Bold"
                           Foreground="#183F36"/>

                <TextBlock Text="إضافة وتعديل بيانات العملاء وإدارة حالة الحساب"
                           FontSize="13"
                           Foreground="#64736F"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="بحث:"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="1"
                         Height="34"
                         Padding="8"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         TextChanged="SearchTextBox_TextChanged"/>

                <Button Grid.Column="2"
                        Content="تحديث"
                        Width="90"
                        Height="34"
                        Margin="10,0,0,0"
                        Click="RefreshButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="10"
                    Padding="10"
                    Margin="0,0,8,0">

                <DataGrid x:Name="CustomersGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="38"
                          FontSize="13"
                          SelectionChanged="CustomersGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود العميل"
                                            Binding="{Binding CustomerCode}"
                                            Width="115"/>

                        <DataGridTextColumn Header="اسم العميل"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="الهاتف"
                                            Binding="{Binding Phone}"
                                            Width="125"/>

                        <DataGridCheckBoxColumn Header="نشط"
                                                Binding="{Binding IsActive}"
                                                Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="10"
                    Padding="15"
                    Margin="8,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="بيانات العميل"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#183F36"
                                   Margin="0,0,0,15"/>

                        <TextBlock Text="كود العميل"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="CustomerCodeTextBox"
                                 Height="34"
                                 IsReadOnly="True"
                                 Background="#EEF2F1"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="اسم العميل *"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="CustomerNameTextBox"
                                 Height="34"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="رقم الهاتف"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="CustomerPhoneTextBox"
                                 Height="34"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="العنوان"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="CustomerAddressTextBox"
                                 Height="34"
                                 Padding="8"
                                 Margin="0,0,0,12"/>

                        <TextBlock Text="ملاحظات"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"/>

                        <TextBox x:Name="CustomerNotesTextBox"
                                 Height="85"
                                 Padding="8"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,15"/>

                        <Button Content="عميل جديد"
                                Height="38"
                                Margin="0,0,0,8"
                                Background="#E8EEF0"
                                Click="NewCustomerButton_Click"/>

                        <Button Content="إضافة العميل"
                                Height="40"
                                Background="#16865D"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Margin="0,0,0,8"
                                Click="AddCustomerButton_Click"/>

                        <Button Content="حفظ التعديلات"
                                Height="40"
                                Background="#246B9A"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Margin="0,0,0,8"
                                Click="UpdateCustomerButton_Click"/>

                        <Button x:Name="ToggleCustomerButton"
                                Content="إيقاف / تنشيط العميل"
                                Height="40"
                                Background="#A66A20"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Margin="0,0,0,8"
                                Click="ToggleCustomerButton_Click"/>

                        <Separator Margin="0,8,0,8"/>

                        <Button x:Name="CustomerAccountButton"
                                Content="كشف الحساب والتحصيل"
                                Height="44"
                                Background="#183F36"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Margin="0,0,0,8"
                                Click="CustomerAccountButton_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Button Grid.Row="3"
                Content="إغلاق"
                Width="110"
                Height="38"
                HorizontalAlignment="Left"
                Margin="0,12,0,0"
                Click="CloseButton_Click"/>

    </Grid>
</Window>
