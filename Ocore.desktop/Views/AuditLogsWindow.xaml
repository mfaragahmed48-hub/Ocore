<Window x:Class="Ocore.desktop.Views.AuditLogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سجل النشاطات"
        Height="700"
        Width="1250"
        MinHeight="600"
        MinWidth="1050"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7F6"
        FlowDirection="RightToLeft">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="سجل نشاطات النظام"
                   FontSize="25"
                   FontWeight="Bold"
                   Foreground="#174D3A"
                   Margin="0,0,0,20"/>

        <WrapPanel Grid.Row="1"
                   Margin="0,0,0,15"
                   VerticalAlignment="Center">

            <Button Content="تحديث السجل"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,5"
                    Background="#174D3A"
                    Foreground="White"
                    Click="Refresh_Click"/>

            <Button Content="تصدير Excel"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,5"
                    Background="#217346"
                    Foreground="White"
                    Click="ExportExcel_Click"/>

            <TextBox x:Name="SearchUserTextBox"
                     Width="170"
                     Height="35"
                     Margin="0,0,10,5"
                     Padding="8"
                     VerticalContentAlignment="Center"
                     FontSize="14"
                     ToolTip="ابحث باسم المستخدم"
                     TextChanged="SearchUserTextBox_TextChanged"/>

            <ComboBox x:Name="ActionFilterComboBox"
                      Width="155"
                      Height="35"
                      Margin="0,0,10,5"
                      VerticalContentAlignment="Center"
                      FontSize="14"
                      SelectedIndex="0"
                      SelectionChanged="ActionFilterComboBox_SelectionChanged">

                <ComboBoxItem Content="كل العمليات" Tag=""/>
                <ComboBoxItem Content="إنشاء" Tag="Create"/>
                <ComboBoxItem Content="تعديل" Tag="Update"/>
                <ComboBoxItem Content="تنشيط حساب" Tag="Activate"/>
                <ComboBoxItem Content="إيقاف حساب" Tag="Deactivate"/>
                <ComboBoxItem Content="حذف" Tag="Delete"/>
                <ComboBoxItem Content="تسجيل دخول" Tag="Login"/>
                <ComboBoxItem Content="تسجيل خروج" Tag="Logout"/>

            </ComboBox>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center">

                <TextBlock Text="من:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <DatePicker x:Name="StartDatePicker"
                            Width="135"
                            Height="35"
                            SelectedDateChanged="DateFilter_Changed"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,10,5"
                        VerticalAlignment="Center">

                <TextBlock Text="إلى:"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0"/>

                <DatePicker x:Name="EndDatePicker"
                            Width="135"
                            Height="35"
                            SelectedDateChanged="DateFilter_Changed"/>

            </StackPanel>

            <Button Content="مسح التواريخ"
                    Width="105"
                    Height="35"
                    Margin="0,0,10,5"
                    Click="ClearDates_Click"/>

            <TextBlock x:Name="LogsCountText"
                       Text="عدد العمليات: 0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="5,0,0,5"/>

        </WrapPanel>

        <DataGrid x:Name="LogsDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#DCE5E0">

            <DataGrid.Columns>

                <DataGridTextColumn Header="رقم"
                                    Binding="{Binding Id}"
                                    Width="60"/>

                <DataGridTextColumn Header="المستخدم"
                                    Binding="{Binding Username}"
                                    Width="110"/>

                <DataGridTextColumn Header="العملية"
                                    Binding="{Binding ActionType}"
                                    Width="110"/>

                <DataGridTextColumn Header="نوع العنصر"
                                    Binding="{Binding EntityType}"
                                    Width="110"/>

                <DataGridTextColumn Header="رقم العنصر"
                                    Binding="{Binding EntityId}"
                                    Width="90"/>

                <DataGridTextColumn Header="التفاصيل"
                                    Binding="{Binding Details}"
                                    Width="*"/>

                <DataGridTextColumn Header="الجهاز"
                                    Binding="{Binding DeviceName}"
                                    Width="140"/>

                <DataGridTextColumn Header="التاريخ والوقت"
                                    Binding="{Binding CreatedAt,
                                    StringFormat=yyyy/MM/dd HH:mm:ss}"
                                    Width="165"/>

            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3"
                Content="إغلاق"
                Width="100"
                Height="35"
                HorizontalAlignment="Left"
                Margin="0,15,0,0"
                Click="Close_Click"/>

    </Grid>
</Window>
