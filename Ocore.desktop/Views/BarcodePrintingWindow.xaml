<Window x:Class="Ocore.desktop.Views.BarcodePrintingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O CORE - طباعة باركود الأصناف"
        Height="720"
        Width="1150"
        MinHeight="650"
        MinWidth="1000"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#123D35"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#1D6656"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE5E2"/>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="95"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <!-- رأس الشاشة -->
        <Border Grid.Row="0"
                Background="{StaticResource PrimaryBrush}"
                CornerRadius="8"
                Padding="18"
                Margin="0,0,0,10">
            <DockPanel>
                <TextBlock Text="O CORE"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"/>

                <TextBlock Text="إدارة وطباعة باركود الأصناف"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="25,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- المحتوى الرئيسي -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.45*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- اختيار الأصناف -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="البحث عن الأصناف"
                          Grid.Row="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchTextBox"
                                 Grid.Column="0"
                                 Height="38"
                                 FontSize="14"
                                 ToolTip="ابحث بالاسم أو كود الصنف أو الباركود"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="SearchButton"
                                Grid.Column="1"
                                Content="بحث"
                                Background="{StaticResource AccentBrush}"
                                Foreground="White"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="قائمة الأصناف"
                          Grid.Row="1">
                    <DataGrid x:Name="ProductsDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              FontSize="12"
                              Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود الصنف"
                                                Binding="{Binding ProductCode}"
                                                Width="95"/>
                            <DataGridTextColumn Header="اسم الصنف"
                                                Binding="{Binding Name}"
                                                Width="*"/>
                            <DataGridTextColumn Header="الباركود"
                                                Binding="{Binding Barcode}"
                                                Width="145"/>
                            <DataGridTextColumn Header="سعر البيع"
                                                Binding="{Binding SalePrice}"
                                                Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="AddSelectedButton"
                            Content="إضافة المحدد للطباعة"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            Width="175"/>

                    <Button x:Name="AddAllButton"
                            Content="إضافة كل الأصناف"
                            Width="140"/>
                </StackPanel>

                <GroupBox Header="الأصناف المحددة للطباعة"
                          Grid.Row="3">
                    <DataGrid x:Name="PrintQueueDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              SelectionUnit="CellOrRowHeader"
                              CanUserAddRows="False"
                              CanUserResizeRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeight="34"
                              FontSize="12"
                              KeyboardNavigation.TabNavigation="Local">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="كود الصنف"
                                                Binding="{Binding ProductCode, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="95"/>

                            <DataGridTextColumn Header="اسم الصنف"
                                                Binding="{Binding Name, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="*"/>

                            <DataGridTextColumn Header="العدد"
                                                Binding="{Binding LabelCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                IsReadOnly="False"
                                                Width="70"/>

                            <DataGridTextColumn Header="الباركود"
                                                Binding="{Binding Barcode, Mode=OneWay}"
                                                IsReadOnly="True"
                                                Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

            <!-- إعدادات الطابعة والمعاينة -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="230"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <GroupBox Header="إعدادات طابعة الباركود"
                          Grid.Row="0">
                    <StackPanel>
                        <TextBlock Text="نوع الطباعة"
                                   Margin="5,5,5,2"
                                   Foreground="#666666"/>

                        <TextBlock Text="ملصقات رول حراري فقط"
                                   Margin="5,0,5,10"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>

                        <TextBlock Text="الطابعة المحددة"
                                   Margin="5,3,5,2"
                                   Foreground="#666666"/>

                        <TextBlock x:Name="PrinterNameText"
                                   Text="لم يتم تحديد طابعة"
                                   Margin="5,0,5,8"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <Grid Margin="5,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="عرض الملصق"/>
                                <TextBlock x:Name="LabelWidthText"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ارتفاع الملصق"/>
                                <TextBlock x:Name="LabelHeightText"
                                           FontSize="15"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>

                        <Button x:Name="PrinterSettingsButton"
                                Content="إعدادات الطابعات"
                                Background="{StaticResource PrimaryBrush}"
                                Foreground="White"
                                Height="38"
                                Margin="3,10,3,3"/>
                    </StackPanel>
                </GroupBox>

                <!-- معاينة الملصق -->
                <GroupBox Header="معاينة الملصق"
                          Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#EDF1F0"
                                BorderBrush="#DCE5E2"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="5"
                                Padding="10">
                            <Viewbox Stretch="Uniform">
                                <Border x:Name="PreviewBorder"
                                        Width="132.28"
                                        Height="45.35"
                                        Background="White"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1">
                                    <Grid x:Name="PreviewContainer">
                                        <TextBlock Text="معاينة ملصق الباركود"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#777777"
                                                   FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Viewbox>
                        </Border>

                        <TextBlock Grid.Row="1"
                                   Text="المعاينة توضح شكل الملصق قبل الطباعة"
                                   Foreground="#666666"
                                   FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="5"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>

        <!-- الصف السفلي -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,5,0,0"
                Padding="4">

            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="RemoveSelectedButton"
                        Grid.Column="0"
                        Content="حذف من قائمة الطباعة"
                        Width="165"
                        Height="42"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="PrintButton"
                            Content="طباعة الملصقات"
                            Width="160"
                            Height="42"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            FontWeight="Bold"/>

                    <Button x:Name="PreviewButton"
                            Content="تحديث المعاينة"
                            Width="135"
                            Height="42"/>

                    <Button x:Name="CloseButton"
                            Content="إغلاق"
                            Width="90"
                            Height="42"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
