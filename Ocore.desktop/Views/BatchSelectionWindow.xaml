<Window x:Class="Ocore.desktop.Views.BatchSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="اختيار تشغيلة الصنف"
        Height="560"
        Width="900"
        MinHeight="480"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        FlowDirection="RightToLeft"
        Background="#F3F6F8"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#174B80"
                CornerRadius="9"
                Padding="15"
                Margin="0,0,0,12">

            <DockPanel>
                <TextBlock Text="📦"
                           FontSize="26"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <TextBlock Text="اختيار تشغيلة الصنف"
                           FontSize="21"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <Button Content="✕"
                        DockPanel.Dock="Left"
                        Width="35"
                        Height="35"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="20"
                        Click="CancelButton_Click"/>
            </DockPanel>
        </Border>

        <!-- Product Information -->
        <Border Grid.Row="1"
                Background="#E0EDFC"
                CornerRadius="8"
                Padding="13"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="الصنف"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="ProductNameText"
                               Text="—"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#173B63"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center">

                    <TextBlock Text="الكمية المطلوبة"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="RequiredQuantityText"
                               Text="0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#173B63"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center">

                    <TextBlock Text="المتبقي للاختيار"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="RemainingQuantityText"
                               Text="0"
                               FontSize="21"
                               FontWeight="Bold"
                               Foreground="#1672D4"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Available Batches -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="اختر تشغيلة واحدة من التشغيلات المتاحة"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#173B63"
                           Margin="3,2,3,9"/>

                <DataGrid x:Name="BatchesDataGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeight="46"
                          FontSize="13"
                          SelectionChanged="BatchesDataGrid_SelectionChanged">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="رقم التشغيلة"
                                            Binding="{Binding BatchNumber}"
                                            IsReadOnly="True"
                                            Width="1.3*"/>

                        <DataGridTextColumn Header="تاريخ الصلاحية"
                                            Binding="{Binding ExpiryDate}"
                                            IsReadOnly="True"
                                            Width="1.2*"/>

                        <DataGridTextColumn Header="الرصيد المتاح"
                                            Binding="{Binding AvailableQuantity, StringFormat={}{0:N3}}"
                                            IsReadOnly="True"
                                            Width="*"/>

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Selection Summary -->
        <Border Grid.Row="3"
                Background="#E0EDFC"
                CornerRadius="8"
                Padding="12"
                Margin="0,12,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="الكمية المطلوبة"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SummaryRequiredText"
                               Text="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#173B63"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center">

                    <TextBlock Text="كمية التشغيلة المختارة"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="SummaryAllocatedText"
                               Text="0"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#16865D"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Center">

                    <TextBlock Text="حالة الاختيار"
                               Foreground="#52677F"
                               FontWeight="Bold"/>

                    <TextBlock x:Name="AllocationStatusText"
                               Text="لم يتم اختيار تشغيلة"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#C07824"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="تأكيد الاختيار ✓"
                    Width="190"
                    Height="43"
                    Margin="5"
                    Background="#16865D"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="ConfirmButton_Click"/>

            <Button Content="إلغاء"
                    Width="145"
                    Height="43"
                    Margin="5"
                    Background="#D94343"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>